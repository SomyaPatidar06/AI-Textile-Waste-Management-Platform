# Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local or production use.

# Application Settings
PROJECT_NAME="AI Textile Waste Management Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
# Generate a production key with: openssl rand -hex 32
SECRET_KEY="dev-insecure-secret-key-change-in-production-replace-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite (Local Development default):
DATABASE_URL="sqlite:///./textile_waste.db"
# PostgreSQL (Optional Staging/Production):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/textile_waste_db"

# Storage & File Limits
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_BYTES=10485760

# CORS Allowed Origins
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# AI & Quality Thresholds
DEFECT_CONFIDENCE_THRESHOLD=0.45
AI_UNCERTAINTY_MARGIN=0.20
AI_UNCERTAINTY_ENTROPY=0.70
MATERIAL_MODEL_VERSION="v1.0-uncalibrated-option-b"
DEFECT_MODEL_VERSION="v1.0-provisional-0.45"
